# Instância do Claude (agente de desenvolvimento): mesmo código-fonte, dados e containers separados da instância do dono.
# Carregado pelo start.sh/start.ps1 quando NARNIA_INSTANCE=claude (definido em .claude/settings.json para as sessões
# do Claude Code). Nada aqui toca ./data, as portas 5173/3100 nem os projetos Docker do dono.
NARNIA_DEV_PROJECT_NAME=narnia-claude
NARNIA_PROD_PROJECT_NAME=narnia-claude-prod
NARNIA_DEV_PORT=5174
NARNIA_DEV_API_PORT=3200
NARNIA_DEV_DATA_DIR=/app/.claude-data/dev
NARNIA_DATA_DIR=./.claude-data/prod
NARNIA_DEV_BACKUP_DIR=/app/.claude-data/backups
NARNIA_BACKUP_HOST_DIR=./.claude-data/prod-backups
NARNIA_ENV_FILE=.claude-data/.env
NARNIA_PORT_START=3250
NARNIA_PORT_END=3299
NARNIA_OAUTH_PORT=8189
NARNIA_TOKEN=claude-token
# Padrão sem custo: testes do Claude usam o mock. Para o provider real: NARNIA_PROVIDER=claude-code no comando
# e login uma vez na instância (NARNIA_INSTANCE=claude ./start.sh cli login), que usa volume de login próprio.
NARNIA_PROVIDER=mock
# C7/CM-4: a instância do Claude usa sempre o código da raiz e nunca monta ./data nem ./backups do dono
NARNIA_SRC_DIR=.
NARNIA_DATA_MOUNT=./.claude-data/dev
NARNIA_BACKUP_MOUNT=./.claude-data/backups
# modo B (F04): nomes próprios no Claude Code; o install-plugin desta instância só roda com HOME de teste
NARNIA_MCP_NAME=narnia-jobs-claude
NARNIA_PLUGIN_MARKETPLACE=narnia-jobs-claude-local
NARNIA_PLUGIN_STAGE=./.claude-data/plugin-build
# Phoenix da instância (F04-15): portas próprias, sem colidir com o do dono (6006/4317)
NARNIA_PHOENIX_PORT=6106
NARNIA_PHOENIX_GRPC_PORT=4417
