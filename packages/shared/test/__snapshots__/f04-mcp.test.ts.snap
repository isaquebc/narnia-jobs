            ],
            "type": "object",
          },
          "type": "array",
        },
        "nextCursor": {
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "items",
        "nextCursor",
      ],
      "type": "object",
    },
  },
  "research.save": {
    "description": "Registra uma fonte pesquisada (só domínios confiáveis); o valor só vira dado do usuário depois de confirmado.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "url": {
          "format": "uri",
          "type": "string",
        },
        "usedFor": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "url",
        "title",
        "excerpt",
        "usedFor",
      ],
      "type": "object",
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
        },
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "trustTag": {
          "enum": [
            "official",
            "survey",
            "jobboard",
            "other",
          ],
          "type": "string",
        },
      },
      "required": [
        "id",
        "domain",
        "trustTag",
      ],
      "type": "object",
    },
  },
  "session.get": {
    "description": "Dados da sessão de chat atual: categoria, perfil, modelo e execução ligada (clarificação).",
    "input": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "career",
            "clarify",
            "ingest",
            "interview",
          ],
          "type": "string",
        },
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "ingestionRunId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "model": {
          "type": "string",
        },
        "profileId": {
          "minLength": 1,
          "type": "string",
        },
        "state": {
          "enum": [
            "live",
            "hibernated",
            "archived",
            "error",
          ],
          "type": "string",
        },
      },
      "required": [
        "id",
        "profileId",
        "category",
        "model",
        "state",
        "ingestionRunId",
      ],
      "type": "object",
    },
  },
  "session.set_category": {
    "description": "Muda a categoria da sessão atual (muda o conjunto de tools disponível).",
    "input": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "career",
            "clarify",
            "ingest",
            "interview",
          ],
          "type": "string",
        },
      },
      "required": [
        "category",
      ],
      "type": "object",
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean",
        },
      },
      "required": [
        "ok",
      ],
      "type": "object",
    },
  },
  "usage.log": {
    "description": "Registra o uso de um turno no modo terminal; ignorado se o mesmo turno já foi registrado.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "cacheRead": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "cacheWrite": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "costUsd": {
          "minimum": 0,
          "type": "number",
        },
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "model": {
          "minLength": 1,
          "type": "string",
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "providerSessionId": {
          "minLength": 1,
          "type": "string",
        },
        "turnIndex": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "providerSessionId",
        "turnIndex",
        "model",
        "inputTokens",
        "outputTokens",
      ],
      "type": "object",
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "recorded": {
          "type": "boolean",
        },
      },
      "required": [
        "recorded",
      ],
      "type": "object",
    },
  },
}
`;
