{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  },
  "globalPassThroughEnv": [
    "REDIS_URL",
    "OCR_REAL",
    "TESSDATA_PATH",
    "NARNIA_DATA_DIR",
    "NARNIA_PROVIDER",
    "NARNIA_TOKEN",
    "CI"
  ]
}
